---
import LogoutButton from './svelte/LogoutButton.svelte';
import type { ILink } from "../types";

interface Props {
  links: ILink[];
}
const {links} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, "");
---

<header>
  <nav>
    <div class="placeholder"></div>
    <ul class="nav-links">
        <li class="icon">
          <?xml version="1.0" encoding="utf-8"?><!-- Uploaded to: SVG Repo, www.svgrepo.com, Generator: SVG Repo Mixer Tools -->
          <svg width="34px" height="34px" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.792725 12.2929L5.08562 8.00002L0.792725 3.70712L2.20694 2.29291L7.91405 8.00002L2.20694 13.7071L0.792725 12.2929Z" fill="#000000"/>
            <path d="M7.00006 15H15.0001V13H7.00006V15Z" fill="#000000"/>
          </svg>
        </li>
      {
        links.map((link) => (
          <li>
            <a href={link.href} target={link.target} class={currentPath === link.href.replace(/\/+$/, "") ? 'active' : ''} >
              {link.name}
            </a>
          </li>
        ))
      }
      <li>
        <LogoutButton client:load/>
      </li>
    </ul>
    <button class="hamburger-btn">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"> <line x1="3" y1="4"  x2="21" y2="4" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="20" x2="21" y2="20" /></svg>
    </button>
  </nav>
</header>

<script>
  /**
   * ANCHOR TODO Animationen zum Hamburger Button hinzufügen
   * ANCHOR TODO Supabase - wegkommen von SignInAnonymously
   */
  
  const btn = document.querySelector('.hamburger-btn')! as HTMLElement;

  const menu = document.querySelector('.nav-links')!;

  const showMenu = () => {
    menu.classList.remove('hide');
    menu.classList.add('show');
  }

  const hideMenu = () => {
    menu.classList.remove('show')
    menu.classList.add('hide');
  }

  btn.onclick = () => {
    if(!menu.classList.contains('show')) {
      showMenu();
    } else {
      hideMenu();
    }
  }

</script>

<style>
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      background-color: rgb(240, 218, 54);
      /* font-family: ui-monospace, "Cascadia Code", Consolas, monospace; */
      height: 75px;
      flex-shrink: 0;
    }

    .icon {
      min-width: 34px;
    }

    ul {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
      }

    li {
      display: inline-flex;
      list-style: none;
      margin: 0 16px;
    }

    li > a {
      color: #666;
    }
    
    li > a.active {
      color: #000;
      font-weight: 500;
    }

    .hamburger-btn {
      display: none;
    }

    @media(max-width: 767px) {
      header {
        display: block;
        width: 100%;
        height: auto;
        padding: 12px;
      }

      nav {
        width: 100%;
        display: flex;
        justify-content: space-between;
      }

      .placeholder {
        width: 30px;
      }

      ul {
        flex-direction: column;
        margin: 0;
        padding: 0;
      }

      ul > li {
        margin: 4px;
      }
      .nav-links {
        display: none;
      }

      .nav-links.show {
        display: flex;
      }

      .nav-links.hide {
        display: none;
      }

      .hamburger-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #666;
        border-radius: 6px;
        padding: 3px;
        height: 44px;
        width: 40px;
        border: none;
      }

      .hamburger-btn:hover {
        cursor: pointer;
        background-color: #808080;
      }

      /* .hamburger-btn span {
        position: absolute;
        top: 0;
        left: 0;
        background-color: whitesmoke;
        width: 30px;
        height: 3px;
        margin: 3px;
      }

      .hamburger-btn span:nth-child(1) {
        top: 8px;
        left: 2px;
      }

      .hamburger-btn span:nth-child(2) {
        top: 18px;
        left: 2px;
      }

      .hamburger-btn span:nth-child(3) {
        top: 28px;
        left: 2px;
      } */
    }
    
    @media (prefers-color-scheme: dark) {
      header {
        background-color: #030712;  /* gray-950 */
      }
      
      .icon svg path {
        fill: #f0da36;  /* yellow-400 */
      }
      
      li > a.active {
        color: #f0da36;  /* yellow-400 */
        font-weight: 500;
      }
    }
</style>
